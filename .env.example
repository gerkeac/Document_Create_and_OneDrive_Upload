# MCP Document Generator Server - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/logs/mcp_server.log

# ============================================================================
# Microsoft OAuth Configuration (OneDrive Integration)
# ============================================================================
# IMPORTANT: This MCP server does NOT need OAuth credentials configured here.
# LibreChat handles the OAuth flow and passes access tokens via HTTP headers:
#   - Authorization: Bearer <access_token>
#   - X-User-ID: <user_id>
#
# The MCP server operates statelessly - it extracts tokens from each request
# and uses them to call Microsoft Graph API. No token storage is needed.
#
# To set up OneDrive integration:
# 1. Configure Azure App Registration (see AZURE_SETUP.md)
# 2. Add credentials to LibreChat's environment/config (not here)
# 3. Configure LibreChat's librechat.yaml to connect to this MCP server
#
# For local testing WITHOUT LibreChat, you can set:
# MICROSOFT_ACCESS_TOKEN=your-test-access-token-here

# ============================================================================
# OneDrive Configuration (Phase 2)
# ============================================================================
DEFAULT_ONEDRIVE_PATH=/Documents/ClarityFiles

# ============================================================================
# MCP Server Configuration
# ============================================================================
# Internal container port (default: 3000)
MCP_SERVER_PORT=3000

# External host port (for docker-compose port mapping)
# Set this if port 3000 is already in use on your host
MCP_EXTERNAL_PORT=3000

# Server host binding (0.0.0.0 allows external connections)
MCP_SERVER_HOST=0.0.0.0

# ============================================================================
# Development Settings
# ============================================================================
# Set to DEBUG for more verbose logging during development
# LOG_LEVEL=DEBUG
