# MCP Document Generator Server - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# - DEBUG: Most verbose, shows all header details and token previews (use for troubleshooting)
# - INFO: Standard logging for production (recommended)
# - WARNING: Only warnings and errors
# - ERROR: Only errors
LOG_LEVEL=INFO

# Log file path (inside container)
LOG_FILE=/logs/mcp_server.log

# Log rotation settings (prevents disk space issues)
# Maximum size per log file in bytes (default: 10MB = 10485760 bytes)
LOG_MAX_BYTES=10485760

# Number of backup log files to keep (default: 5)
# Total disk usage = LOG_MAX_BYTES * (LOG_BACKUP_COUNT + 1)
# Default: 10MB * 6 files = ~60MB maximum
LOG_BACKUP_COUNT=5

# ============================================================================
# Microsoft OAuth Configuration (OneDrive Integration)
# ============================================================================
# IMPORTANT: This MCP server does NOT need OAuth credentials configured here.
# LibreChat handles the OAuth flow and passes access tokens via HTTP headers:
#   - Authorization: Bearer <access_token>
#   - X-User-ID: <user_id>
#
# The MCP server operates statelessly - it extracts tokens from each request
# and uses them to call Microsoft Graph API. No token storage is needed.
#
# To set up OneDrive integration:
# 1. Configure Azure App Registration (see AZURE_SETUP.md)
# 2. Add credentials to LibreChat's environment/config (not here)
# 3. Configure LibreChat's librechat.yaml to connect to this MCP server
#
# For local testing WITHOUT LibreChat, you can set:
# MICROSOFT_ACCESS_TOKEN=your-test-access-token-here

# ============================================================================
# OneDrive Configuration (Phase 2)
# ============================================================================
DEFAULT_ONEDRIVE_PATH=/Documents/ClarityFiles

# ============================================================================
# MCP Server Configuration
# ============================================================================
# Internal container port (default: 3000)
MCP_SERVER_PORT=3000

# External host port (for docker-compose port mapping)
# Set this if port 3000 is already in use on your host
MCP_EXTERNAL_PORT=3000

# Server host binding (0.0.0.0 allows external connections)
MCP_SERVER_HOST=0.0.0.0

# ============================================================================
# Development Settings
# ============================================================================

# Troubleshooting OAuth/Bearer Token Issues:
# Uncomment the line below to enable DEBUG logging and see detailed header information
# LOG_LEVEL=DEBUG

# Example customizations for different environments:

# High-traffic production (larger logs):
# LOG_MAX_BYTES=52428800    # 50MB per file
# LOG_BACKUP_COUNT=10       # Keep 10 backups (~550MB total)

# Low-disk environment (smaller logs):
# LOG_MAX_BYTES=5242880     # 5MB per file
# LOG_BACKUP_COUNT=2        # Keep 2 backups (~15MB total)

# See LOGGING_GUIDE.md for more information on viewing and debugging logs
